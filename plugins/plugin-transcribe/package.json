{
  "name": "@deepcraft/plugin-transcribe",
  "version": "0.2.0",
  "description": "NocoBase plugin that gives AI employees an audio transcription tool",
  "displayName": "Transcribe",
  "keywords": [
    "nocobase",
    "nocobase-plugin",
    "openai",
    "transcription",
    "whisper",
    "speech-to-text",
    "ai-tools"
  ],
  "license": "MIT",
  "main": "dist/server/index.js",
  "module": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "nocobase": {
    "defaultEnabled": false,
    "supportedVersions": [
      "2.2.6"
    ],
    "editionLevel": 0
  },
  "files": [
    "dist",
    "client.js",
    "client.d.ts",
    "client-v2.js",
    "client-v2.d.ts",
    "server.js",
    "server.d.ts",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "bash scripts/build.sh",
    "clean": "rm -rf dist",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "peerDependencies": {
    "@nocobase/client": "2.2.6",
    "@nocobase/client-v2": "2.2.6",
    "@nocobase/database": "2.2.6",
    "@nocobase/flow-engine": "2.2.6",
    "@nocobase/server": "2.2.6",
    "@nocobase/utils": "2.2.6",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@nocobase/client": "2.2.6",
    "@nocobase/client-v2": "2.2.6",
    "@nocobase/database": "2.2.6",
    "@nocobase/flow-engine": "2.2.6",
    "@nocobase/server": "2.2.6",
    "@nocobase/utils": "2.2.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.7",
    "antd": "5.24.2",
    "prettier": "^3.9.6",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^11.15.1",
    "typescript": "^5.9.3",
    "zod": "^4.0.0"
  }
}
