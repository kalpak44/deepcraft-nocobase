# Managed by ansible/roles/webdav — edits on the host are overwritten.
#
# Included from the NocoBase vhost, so this is a location block and nothing else.
# The vhost's `location /` proxies to NocoBase; nginx matches the longest prefix,
# so this wins for {{ webdav_location }}/ without the two interfering.

# Without this, {{ webdav_location }} — no trailing slash — does not match the
# prefix below and falls through to the vhost's `location /`, which proxies it to
# NocoBase and answers 200 with the application's index.html. A WebDAV client
# that asks for the share and is handed a web page concludes the share is not
# there: Windows Explorer reports "Windows cannot access" with no further detail,
# and its Map Network Drive dialog is quite willing to drop a trailing slash the
# user typed. Measured: {{ webdav_location }} -> 200 text/html,
# {{ webdav_location }}/ -> 401. Normalising here is what makes the share
# mountable by a client that does not send the slash itself.
#
# absolute_redirect off for the same reason as in the browser role: nginx builds
# Location from $scheme, Cloudflare terminates TLS before the tunnel, so an
# absolute redirect would send an https client to an http:// URL. It is scoped to
# this location so NocoBase's own redirects keep being written as they were.
location = {{ webdav_location }} {
    absolute_redirect off;
    return 301 {{ webdav_location }}/;
}

location {{ webdav_location }}/ {
    # `root`, not `alias` — see the note in the role's defaults. nginx appends
    # the URI to this, so {{ webdav_location }}/x resolves to {{ webdav_dir }}/x.
    root {{ webdav_parent }};

    auth_basic "{{ webdav_realm }}";
    auth_basic_user_file {{ webdav_htpasswd }};

    # The built-in dav module supplies the write verbs; PROPFIND and OPTIONS come
    # from dav_ext and are what make this mountable at all — without them a client
    # cannot enumerate a directory and every mount attempt fails.
    dav_methods PUT DELETE MKCOL COPY MOVE;
    dav_ext_methods PROPFIND OPTIONS LOCK UNLOCK;
    dav_ext_lock zone=webdav;

    # dav-ext answers OPTIONS with "DAV: 2" and never claims class 1, and no
    # client will mount a share that does not. davfs2 says so outright —
    # "mounting failed; the server does not support WebDAV" — while Windows
    # Explorer only manages "Windows cannot access", which is the same refusal
    # with the reason removed.
    #
    # The claim is honest: the share implements class 1 (PROPFIND returns 207)
    # and class 2 on top of it (LOCK returns 201). Only the advertisement was
    # wrong.
    #
    # more_set_headers, not add_header, and that is the whole reason
    # headers-more is installed: add_header appends rather than replaces, and a
    # header the dav-ext module set itself wins regardless — measured, the
    # response still read "DAV: 2" with add_header in place.
    more_set_headers "DAV: 1,2";

    # Without this a PUT into a directory the client has not created yet 409s.
    create_full_put_path on;

    # Windows Explorer finishes every upload with PROPPATCH, to write the Win32
    # creation time, modification time and file attributes. nginx implements
    # PROPPATCH nowhere — not in dav, not in dav-ext — so it answers 405, and
    # Explorer treats a failed PROPPATCH as a failed copy: it DELETEs the file
    # it has just successfully PUT and reports "Can't read from the source file
    # or disk", which points at the source and says nothing about the server.
    # Measured, once per attempt:
    #     PUT 201 -> LOCK 200 -> PROPPATCH 405 -> DELETE 204
    #
    # So answer PROPPATCH with a synthetic 207 claiming the properties were
    # applied. They are not: nginx has nowhere to put them, so Windows
    # timestamps and attributes are not preserved on the share. The file itself
    # is written byte for byte, which is what matters here — and the alternative
    # is that Windows cannot write to the share at all.
    #
    # This `return` runs in the rewrite phase, which is *before* the access
    # phase where auth_basic lives — see the note in .claude/rules/nocobase.md.
    # An anonymous PROPPATCH therefore gets the 207 rather than a 401. That is
    # acceptable only because the response is a fixed string that echoes back
    # the caller's own URI: it performs no action, touches no file, and reveals
    # neither the existence nor the contents of anything.
    # more_set_headers, not add_header: `return` gives the response nginx's
    # default_type, so add_header leaves *two* Content-Type headers on it —
    # measured, "application/octet-stream" followed by the one added here. A
    # client reads the first and sees binary rather than XML. headers-more
    # replaces instead of appending, which is the whole reason it is installed.
    if ($request_method = PROPPATCH) {
        more_set_headers "Content-Type: text/xml; charset=utf-8";
        return 207 '<?xml version="1.0" encoding="utf-8"?>\n<D:multistatus xmlns:D="DAV:">\n<D:response>\n<D:href>$request_uri</D:href>\n<D:propstat>\n<D:status>HTTP/1.1 200 OK</D:status>\n</D:propstat>\n</D:response>\n</D:multistatus>\n';
    }

    # nginx's MKCOL handler rejects any URI that does not end in "/" with a bare
    # 409, and clients differ on whether they send the slash — measured: without
    # it 409, with it 201. Normalising here is what stops "new folder" failing
    # for some clients and working for others.
    if ($request_method = MKCOL) {
        rewrite ^(.*[^/])$ $1/ break;
    }

    # Group-writable so the files stay usable from a shell on the box; every
    # upload is owned by {{ webdav_owner }} regardless of which account wrote it.
    dav_access user:rw group:rw all:r;

    client_max_body_size {{ webdav_max_body_size }};
    # Same filesystem as the share, or large uploads die on a cross-device rename.
    client_body_temp_path {{ webdav_tmp }};

    # Only affects a plain browser GET on a directory; WebDAV clients list with
    # PROPFIND. Handy for checking the share from a browser.
    autoindex on;
}
