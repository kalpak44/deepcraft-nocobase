# Managed by ansible/roles/nocobase — edits on the host are overwritten.
APP_ENV={{ nocobase_app_env }}
APP_KEY={{ nocobase_app_key }}
APP_PORT={{ nocobase_app_port }}
TZ={{ nocobase_timezone }}

API_BASE_PATH=/api/
API_BASE_URL=

PLUGIN_PACKAGE_PREFIX=@nocobase/plugin-,@nocobase/preset-

DB_DIALECT=postgres
DB_HOST={{ nocobase_db_host }}
DB_PORT={{ nocobase_db_port }}
DB_DATABASE={{ nocobase_db_name }}
DB_USER={{ nocobase_db_user }}
DB_PASSWORD={{ nocobase_db_password }}
DB_LOGGING=off
# Must stay false: the CRM template was dumped without it and the restore checks.
DB_UNDERSCORED={{ nocobase_db_underscored | lower }}

# Only read the first time the database is initialised.
INIT_ROOT_EMAIL={{ nocobase_root_email }}
INIT_ROOT_PASSWORD={{ nocobase_root_password }}
INIT_ROOT_USERNAME={{ nocobase_root_username }}
INIT_ROOT_NICKNAME={{ nocobase_root_nickname }}
