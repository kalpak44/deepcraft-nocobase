# OS
.DS_Store

# Editors
.idea/
.vscode/

# Ansible
*.retry

# Never commit connection material — it comes from repo secrets at runtime
*.pem
id_rsa*
id_ed25519*
.env
.env.*
!.env.example

# Anything a build or a local run leaves behind, anywhere in the tree
*.log
*.tsbuildinfo
coverage/

# Fetched backups — real customer data, and large
/backups/

# Installed on demand by `just smoke`, never committed
/scripts/node_modules/
/scripts/package-lock.json

# Left behind by running an MCP server locally — ansible ships the sources only
/mcp_servers/*/node_modules/

# Plugin build artefacts — `app/` is a whole NocoBase source tree that
# plugins/build.sh downloads, `dist/` is the packed tarball the release carries
/plugins/*/app/
/plugins/*/dist/
/plugins/*/node_modules/
/plugins/*/storage/

# Nothing reads these: the build runs yarn inside the NocoBase workspace, which
# ignores package-lock.json. Committing one only feeds Dependabot the pinned
# @nocobase/* dependency tree, whose transitive advisories cannot be fixed
# without floating the version that must match the box.
/plugins/*/package-lock.json
