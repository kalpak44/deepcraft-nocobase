# Copy to .env and fill in. Every just recipe reads this automatically.
#   cp .env.example .env
#
# .env is gitignored — never commit it.

# ── Where the box is ─────────────────────────────────────────────────────────
NOCOBASE_HOST=192.168.1.5
NOCOBASE_SSH_PORT=22022
NOCOBASE_SSH_USER=root

# ── Deploy key ───────────────────────────────────────────────────────────────
# Root on the container. Ask an admin, or from a homelab-infra checkout:
#   just output proxmox nocobase-lxc ssh_private_key
#
# Multi-line values need quotes, so the base64 form is easier to paste:
#   base64 < id_ed25519 | tr -d '\n'
NOCOBASE_SSH_PRIVATE_KEY=

# ── Cloudflare WARP ──────────────────────────────────────────────────────────
# Only needed off the home LAN — but then both values are required, on macOS as
# much as on Linux. Enrolment is by service token on every platform; there is no
# identity provider and no browser sign-in. Ask an admin, or from a homelab-infra
# checkout:
#   just output cloudflare shared/zero-trust warp_service_token_client_id
#   just output cloudflare shared/zero-trust warp_service_token_client_secret
CF_TEAM_NAME=proud-block-d46f
CF_WARP_CLIENT_ID=
CF_WARP_CLIENT_SECRET=

# ── Postgres ─────────────────────────────────────────────────────────────────
# Placeholders — ask an admin for the real host, credentials and database.
# The server sits on the same private network as the box (home LAN or WARP).
POSTGRES_HOST=192.168.1.x
POSTGRES_PORT=5432
POSTGRES_DATABASE_NAME=example-db
POSTGRES_DATABASE_USERNAME=example-user
POSTGRES_DATABASE_PASSWORD=

# ── NocoBase ─────────────────────────────────────────────────────────────────
# The public site, used by `just smoke` to load the pages in a browser. No
# trailing slash.
NOCOBASE_PUBLIC_URL=https://ownai.deepcraftstudio.com
# APP_KEY signs every user token — rotating it logs everyone out. Generate with:
#   openssl rand -base64 256 | tr -d '\n'
NOCOBASE_APP_KEY=
# The superuser created the first time the database is initialised.
NOCOBASE_ROOT_EMAIL=admin@example.com
NOCOBASE_ROOT_USERNAME=admin
NOCOBASE_ROOT_PASSWORD=

# ── Ciela ────────────────────────────────────────────────────────────────────
# The subscription the ciela-mcp server logs into web7.ciela.net with, so the
# Siela AI employee can read Bulgarian legislation. Ask an admin.
CIELA_USERNAME=
CIELA_PASSWORD=

# ── Supervised browser ───────────────────────────────────────────────────────
# The account that may open the takeover page at /browser/ and drive the
# research browser by hand to clear a Cloudflare challenge for Lexy.
#
# The account itself lives in /etc/nginx/browser.htpasswd on the box, created
# with `just browser-user-add NAME`; these are the written-down copy, kept
# somewhere gitignored rather than only in someone's password manager.
#
# They are also read at deploy time: the lex_mcp role derives base64("user:pass")
# from them and gives it to Lexy, so the link she hands out on a Cloudflare
# challenge opens the browser without anyone hunting for a password. Leave them
# empty and she hands out the plain URL instead — safer, and one more step for
# whoever is clearing the challenge. That token does not expire; revoke it with
# `just browser-user-remove NAME`.
BROWSER_TAKEOVER_USER=
BROWSER_TAKEOVER_PASSWORD=

# Optional, and normally left empty. The takeover page at /browser/ is already
# behind its own nginx basic auth (`just browser-user-add NAME`), and x11vnc is
# bound to loopback where websockify is its only client — so a VNC password
# guards a hop that is already closed, at the cost of a second credential
# somebody has to find while they are mid-challenge.
#
# Set it to require one anyway, as defence in depth against something else on
# the box reaching the display. x11vnc stores an obfuscated blob rather than the
# password, so changing this later means deleting /data/chrome/vnc.pass on the
# box to have it rewritten.
BROWSER_VNC_PASSWORD=
